    handoff: 0
  - chapter: 3
    stepName: Put wrench into place
    fetcherText: The Assembler is putting the wrench on the first lug nut.
    assemblerText: 
    item: 0
    handoff: 0
  - chapter: 3
    stepName: Tighten lug nut 1
    fetcherText: The Assembler is snugging each lug nut one turn.
    assemblerText: 
    item: 0
    handoff: 0
