  entries:
  - chapter: 0
    stepName: Hand over the lug wrench
    fetcherText: 'Assembler needs: lug wrench. Bring it from the workbench to the
      car and hand it over.'
    assemblerText: 'Fetcher is bringing: lug wrench'
    item: 1
    handoff: 1
  - chapter: 0
    stepName: Place wrench on lug bolt 1
    fetcherText: The Assembler is putting the wrench on the first lug bolt.
    assemblerText: 
    item: 0
    handoff: 0
  - chapter: 0
    stepName: Loosen lug bolt 1
    fetcherText: The Assembler is loosening each lug bolt one turn. Next you bring
      the screw jack.
    assemblerText: 
    item: 0
    handoff: 0
  - chapter: 0
    stepName: Loosen lug bolt 2
    fetcherText: The Assembler is loosening each lug bolt one turn. Next you bring
      the screw jack.
    assemblerText: 
    item: 0
    handoff: 0
  - chapter: 0
    stepName: Loosen lug bolt 3
    fetcherText: The Assembler is loosening each lug bolt one turn. Next you bring
      the screw jack.
    assemblerText: 
    item: 0
    handoff: 0
  - chapter: 0
    stepName: Loosen lug bolt 4
    fetcherText: The Assembler is loosening each lug bolt one turn. Next you bring
      the screw jack.
    assemblerText: 
    item: 0
    handoff: 0
  - chapter: 0
    stepName: Loosen lug bolt 5
    fetcherText: The Assembler is loosening each lug bolt one turn. Next you bring
      the screw jack.
    assemblerText: 
    item: 0
    handoff: 0
  - chapter: 0
    stepName: End Ch1
    fetcherText: Next you bring the screw jack.
    assemblerText: 
    item: 0
    handoff: 0
  - chapter: 1
    stepName: Hand over the screw jack
    fetcherText: 'Assembler needs: screw jack. Bring it from the workbench to the
      car and hand it over.'
    assemblerText: 'Fetcher is bringing: screw jack'
    item: 2
    handoff: 1
  - chapter: 1
    stepName: Place car jack under car
    fetcherText: The Assembler is placing the jack under the car.
    assemblerText: 
    item: 0
    handoff: 0
  - chapter: 1
    stepName: Crank jack to lift car
    fetcherText: The Assembler is raising the car.
    assemblerText: 
    item: 0
    handoff: 0
  - chapter: 1
    stepName: End Ch2
    fetcherText: Next the Assembler takes the wheel off and hands it to you.
    assemblerText: 
    item: 0
    handoff: 0
  - chapter: 2
    stepName: Unscrew lug nut 1
    fetcherText: The Assembler is removing the lug nuts. Next you take the old wheel.
    assemblerText: 
    item: 0
    handoff: 0
  - chapter: 2
    stepName: Unscrew lug nut 2
    fetcherText: The Assembler is removing the lug nuts. Next you take the old wheel.
    assemblerText: 
    item: 0
    handoff: 0
