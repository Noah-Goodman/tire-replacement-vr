    stepName: Tighten lug nut 4
    fetcherText: Put the jack on the RETURN JACK spot in the garage.
    assemblerText: 
    item: 2
    handoff: 0
  - chapter: 4
    stepName: End Ch5
    fetcherText: Put the jack on the RETURN JACK spot in the garage to finish.
